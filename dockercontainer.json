{
  "name": "WordPress in Codespaces",
  "dockerComposeFile": "docker-compose.yml",
  "service": "wordpress",
  "workspaceFolder": "/workspaces/${localWorkspaceFolder}",
  "forwardPorts": [80, 8080],
  "portsAttributes": {
    "80": {
      "label": "WordPress"
    },
    "8080": {
      "label": "phpMyAdmin"
    }
  },
  "postCreateCommand": ["sudo chown -R www-data:www-data /var/www/html","./replace-url.sh"]
}


